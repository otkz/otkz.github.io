{"config":{"lang":["ja"],"separator":"[\\s\\-\u3000\u3001\u3002\uff0c\uff0e]+","pipeline":["stemmer"]},"docs":[{"location":"","title":"\u306f\u3058\u3081\u306b","text":""},{"location":"#_2","title":"\u81ea\u5df1\u7d39\u4ecb","text":"<p>\u95a2\u897f\u3067WEB\u30a8\u30f3\u30b8\u30cb\u30a2\u3084\u3063\u3066\u307e\u3059\u3002 \u793e\u5185\u30b7\u30b9\u30c6\u30e0\u306e\u904b\u7528\u30fb\u4fdd\u5b88\u304c\u30e1\u30a4\u30f3\u3067\u3001PHP\u3092\u3088\u304f\u89e6\u3063\u3066\u307e\u3059\u3002 \u300c\u3053\u308c\u3001\u524d\u3082\u8abf\u3079\u305f\u3084\u3064\u3084\u3093\u2026\u300d\u3092\u6e1b\u3089\u3059\u305f\u3081\u306b\u5099\u5fd8\u9332\u3092\u6b8b\u3057\u3066\u307e\u3059\u3002 \u3064\u3044\u3067\u306b\u8ab0\u304b\u306e\u5f79\u306b\u7acb\u3066\u305f\u3089\u5b09\u3057\u3044\u3067\u3059\u3002  </p>"},{"location":"knowledge-of-develop/","title":"\u958b\u767a","text":""},{"location":"knowledge-of-develop/#_1","title":"\u30a2\u30fc\u30ad\u30c6\u30af\u30c1\u30e3\u5d29\u308c\u3092\u9632\u3050","text":"<ul> <li>\u8a2d\u8a08\u6240\u306b\u8a2d\u8a08\u601d\u60f3\u3092\u8a18\u8f09\u3059\u308b</li> </ul>"},{"location":"knowledge-of-develop/#_2","title":"\u975e\u6a5f\u80fd\u8981\u4ef6\u306e\u8003\u616e\u6f0f\u308c\u3092\u9632\u3050","text":"<ul> <li>\u8981\u4ef6\u5b9a\u7fa9\u306e\u6bb5\u968e\u3067\u30e6\u30fc\u30b6\u30fc\u306e\u5229\u7528\u30b7\u30fc\u30f3\u3092\u3082\u3068\u306b\u975e\u6a5f\u80fd\u8981\u4ef6\u3092\u30ea\u30b9\u30c8\u30a2\u30c3\u30d7\u3057\u3066\u3001\u76ee\u6a19\u5024\u3092\u8a2d\u5b9a\u3057\u3066\u304a\u304f<ul> <li>\u3069\u308c\u3050\u3089\u3044\u306e\u6642\u9593\u3067\u51e6\u7406\u3092\u5b8c\u4e86\u3059\u3079\u304d\u304b</li> <li>\u3069\u308c\u3050\u3089\u3044\u4ef6\u6570\u304c\u3042\u308b\u306e\u304b</li> <li>\u5229\u7528\u983b\u5ea6\u306f\u3069\u308c\u3050\u3089\u3044\u304b etc.</li> </ul> </li> </ul>"},{"location":"knowledge-of-develop/#_3","title":"\u3059\u3079\u3066\u306e\u30d0\u30b0\u306f\u76f4\u3059\u3053\u3068\u306f\u3067\u304d\u306a\u3044","text":"<ul> <li>\u9867\u5ba2\u4fa1\u5024\u3068\u30b3\u30b9\u30c8\u3092\u5929\u79e4\u306b\u304b\u3051\u3066\u3001\u5bfe\u5fdc\u3057\u306a\u304f\u3066\u3088\u3044\u3068\u5272\u308a\u5207\u3063\u3066\u3088\u3044\u30d0\u30b0\u3092\u5408\u610f\u3059\u308b</li> </ul>"},{"location":"knowledge-of-develop/#_4","title":"\u30ea\u30ea\u30fc\u30b9\u524d\u3067\u306e\u30b3\u30fc\u30c9\u5909\u66f4\u306f\u907f\u3051\u308b","text":"<ul> <li>\u30c7\u30b0\u30ec\u30fc\u30b7\u30e7\u30f3\u306e\u53ef\u80fd\u6027\u304c\u9ad8\u307e\u308b</li> <li>\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u5185\u3067\u3069\u3046\u3059\u308b\u304b\u3092\u307e\u305a\u78ba\u8a8d\u3059\u308b</li> <li>\u8efd\u5fae\u306a\u5185\u5bb9\u3067\u3042\u308c\u3070\u6b21\u306e\u30ea\u30ea\u30fc\u30b9\u306b\u542b\u3081\u308b\u3088\u3046\u8abf\u6574\u3059\u308b</li> </ul>"},{"location":"knowledge-of-develop/#_5","title":"\u4e0d\u5177\u5408\u8abf\u67fb\u3092\u3057\u3084\u3059\u304f\u3059\u308b","text":"<ul> <li>\u30ed\u30b0\u3092\u53ef\u80fd\u306a\u9650\u308a\u6b8b\u3059\u3088\u3046\u306b\u3059\u308b</li> </ul>"},{"location":"mkdocs/","title":"MkDocs","text":""},{"location":"mkdocs/#_1","title":"\u4f7f\u3044\u65b9","text":""},{"location":"mkdocs/#_2","title":"\u30ed\u30fc\u30ab\u30eb\u30b5\u30fc\u30d0\u30fc\u3092\u8d77\u52d5\u3057\u3066\u3001\u8868\u793a\u78ba\u8a8d\u3092\u3059\u308b","text":"<p>\u6280\u8853\u30e1\u30e2\u306e\u30ea\u30dd\u30b8\u30c8\u30ea\u306e\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u306b\u79fb\u52d5\u3059\u308b</p> <pre><code>cd C:\\Users\\***\\Documents\\repository\\otkz.github.io\\tech-note\n</code></pre> <p>MkDocs\u306e\u30ed\u30fc\u30ab\u30eb\u30b5\u30fc\u30d0\u3092\u8d77\u52d5</p> <pre><code>mkdocs serve\n</code></pre>"},{"location":"mkdocs/#githubpush","title":"GitHub\u306e\u30ea\u30dd\u30b8\u30c8\u30ea\u306bPush\u3059\u308b","text":"<pre><code>mkdocs gh-deploy\n</code></pre>"},{"location":"php/","title":"PHP","text":""},{"location":"php/#_1","title":"\u5236\u5fa1\u69cb\u9020","text":""},{"location":"php/#declarestrict_types1","title":"declare(strict_types=1)","text":"<p>\u53b3\u5bc6\u306a\u578b\u30c1\u30a7\u30c3\u30af\u306e\u8a2d\u5b9a\u306e\u3053\u3068\u3002 \u8a18\u8f09\u3059\u308b\u3053\u3068\u3067\u3001\u578b\u5ba3\u8a00\u306b\u6b63\u78ba\u306b\u5bfe\u5fdc\u3059\u308b\u5024\u306e\u307f\u3092\u53d7\u3051\u5165\u308c\u3001\u305d\u308c\u4ee5\u5916\u306e\u5834\u5408\u306f\u30a8\u30e9\u30fc\u3092\u8fd4\u3059\u3053\u3068\u304c\u53ef\u80fd\u3002 PHP\u3067\u306f\u30c7\u30d5\u30a9\u30eb\u30c8\u3067\u6697\u9ed9\u306e\u578b\u5909\u63db\u304c\u884c\u308f\u308c\u308b\u305f\u3081\u3001\u8a2d\u5b9a\u3057\u3066\u304a\u304f\u307b\u3046\u304c\u7121\u96e3\u3063\u307d\u3044\u3002</p> <pre><code>\u30c7\u30d5\u30a9\u30eb\u30c8\u3067\u306f\u3001PHP \u306f\u8aa4\u3063\u305f\u578b\u306e\u5024\u3092 \u53ef\u80fd\u3067\u3042\u308c\u3070\u671f\u5f85\u3055\u308c\u305f\u30b9\u30ab\u30e9\u30fc\u578b\u306e\u5ba3\u8a00\u306b\u5f93\u3046\u3088\u3046\u81ea\u52d5\u7684\u306b\u5909\u63db\u3059\u308b(coercive \u30e2\u30fc\u30c9)\u3002  \n\u305f\u3068\u3048\u3070\u3001\u95a2\u6570\u306b\u00a0int \u304c\u4e0e\u3048\u3089\u308c\u305f\u304c\u30d1\u30e9\u30e1\u30fc\u30bf\u3067\u6587\u5b57\u5217\u304c\u671f\u5f85\u3055\u308c\u3066\u3044\u305f\u5834\u5408\u3001\u6587\u5b57\u5217\u578b\u306e\u5024\u3092\u53d6\u5f97\u3059\u308b\u3002  \nhttps://www.php.net/manual/ja/language.types.declarations.php#language.types.declarations.strict\n</code></pre> <p>\u4ee5\u4e0b\u30b5\u30f3\u30d7\u30eb\u30b3\u30fc\u30c9\u306f\u3001\u4e8c\u3064\u306e\u5f15\u6570\u3092\u8db3\u3057\u7b97\u3059\u308b\u30e1\u30bd\u30c3\u30c9\u3002 $value1\u306f\u6587\u5b57\u5217\u578b\u3067declare(strict_types=1);\u306e\u8a18\u8f09\u3092\u3059\u308b\u3053\u3068\u3067\u578b\u4e0d\u6b63\u30a8\u30e9\u30fc\u3068\u306a\u308b\u3002 \uff08\u8a18\u8f09\u304c\u306a\u3051\u308c\u3070\u6697\u9ed9\u306e\u578b\u5909\u63db\u304c\u884c\u308f\u308c\u3001\u8a08\u7b97\u7d50\u679c\u304c\u8868\u793a\u3055\u308c\u308b\u3002\uff09</p> <pre><code>&lt;?php\ndeclare(strict_types=1);\n\n$value1 = '0';\n$value2 = 1;\n\necho addition($value1,$value2);\n\nfunction addition(float $value1, float $value2): float\n{\n    return $value1 + $value2;\n}\n</code></pre> <p>\u5b9f\u884c\u7d50\u679c</p> <pre><code>Fatal error: Uncaught TypeError: addition(): Argument #1 ($value1) must be of type float, string given, called in php-wasm run script on line 7 and defined in php-wasm run script:9 Stack trace: #0 php-wasm run script(7): addition('0', 1) #1 {main} thrown in\u00a0php-wasm run script\u00a0on line\u00a09\n</code></pre> <p>\u53c2\u8003 </p> <ul> <li>PHP\u516c\u5f0f\u30de\u30cb\u30e5\u30a2\u30eb_declear </li> <li>PHP\u516c\u5f0f\u30de\u30cb\u30e5\u30a2\u30eb_\u53b3\u5bc6\u306a\u578b\u4ed8\u3051</li> </ul>"}]}